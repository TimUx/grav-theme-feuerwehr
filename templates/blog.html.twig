{% extends 'partials/base.html.twig' %}
{% block content %}
<div class="content-wrapper blog-layout">
  <div class="main-content">
    <div class="posts-grid" id="posts-grid">
      <div class="page-header">
          <h1>{{ page.title }}</h1>
          <div class="post-divider"></div>
      </div>
      {% set collection = page.collection() %}
      {% for post in collection %}
        <article class="post">
          {% if post.media.images|length > 0 %}
            {% set thumb = post.media.images|first %}
            <img src="{{ thumb.resize(300).url }}" alt="{{ post.title|e }}" width="150" loading="lazy">
          {% endif %}
          <div class="post-content">
    {% set post_title = post.title %}

    {% if post_title starts with 'Einsatz:' %}
      <h2>🚨 {{ post_title }} 🚨</h2>
    {% else %}
      <h2>{{ post_title }}</h2>
    {% endif %}
            <div class="post-divider"></div>
            <p class="post-date">{{ post.date|date("d. F Y") }}</p>
            <p>{{ post.content|striptags|trim|slice(0,100) ~ '…' }}</p>
            <a href="{{ post.url }}" class="read-more-btn">{{ theme.posts.read_more_label|default('Weiterlesen') }}</a>
          </div>
        </article>
      {% endfor %}

      {% if config.plugins.pagination.enabled and collection.params.pagination %}
           {% include 'partials/pagination.html.twig' with {'base_url':page.url, 'pagination':collection.params.pagination} %}
      {% endif %}

    </div>
  </div>
  {% include 'partials/sidebar.html.twig' %}
</div>
{% endblock %}
