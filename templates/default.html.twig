{% extends 'partials/base.html.twig' %}
{% block content %}

<div class="content-wrapper post-layout">
  <div class="main-content">
    <article class="post">
      <div class="post-content">
        <h1>{{ page.title }}</h1>
        <div class="post-divider"></div>
        <p class="post-date">{{ page.date|date("d. F Y") }}</p>
        {{ page.content|raw }}
        {% include 'partials/media_gallery.html.twig' with { thumb_w: 200, thumb_h: 100 } %}
      </div>
    </article>
  </div>
  {% include 'partials/sidebar.html.twig' %}
</div>
{% endblock %}
