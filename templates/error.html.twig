{% extends 'partials/base.html.twig' %}

{% block content %}
<div class="fullwidth-content">
    <div class="page-header">
        <h1>{{ 'THEME_FEUERWEHR.ERROR_TITLE'|t|default('Seite nicht gefunden') }}</h1>
        <div class="post-divider"></div>
    </div>
    <article class="post">
        <div class="post-content">
            <p>{{ 'THEME_FEUERWEHR.ERROR_TEXT'|t|default('Die angeforderte Seite konnte nicht gefunden werden.') }}</p>
            {% if page.content %}
                {{ page.content|raw }}
            {% endif %}
            <p><a class="read-more-btn" href="{{ home_url|default(base_url_relative ~ '/') }}">{{ 'THEME_FEUERWEHR.ERROR_HOME'|t|default('Zur Startseite') }}</a></p>
        </div>
    </article>
</div>
{% endblock %}
