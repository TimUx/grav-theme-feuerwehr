{% extends 'partials/base.html.twig' %}
{% block content %}

<div class="fullwidth-content">

    {# Titel und Divider über beiden Spalten #}
    <div class="page-header">
        <h1>{{ page.title }}</h1>
        <div class="post-divider"></div>
    </div>
    <article class="post">
        <div class="post-content">
            {{ page.content|raw }}
        </div>
    </article>
</div>
{% endblock %}
